# Чат-модель LiteLLM. Для прогона без ключа: LLM_MODEL=mock или python main.py --mock
LLM_MODEL="gpt-4o-mini"
# LLM_MODEL="openrouter/openai/gpt-4o-mini"

# Эмбеддинг базы оговорок. Если пусто, для gpt-* и openrouter/* берётся text-embedding-3-small.
# Для других чат-моделей задайте модель эмбеддинга явно или запускайте --mock.
# EMBEDDING_MODEL="text-embedding-3-small"
# EMBEDDING_MODEL="openrouter/openai/text-embedding-3-small"

# Порог косинуса. Пусто: 0.48 для живой модели, 0.2 для мока.
# CLAUSE_SCORE_THRESHOLD="0.48"

OPENAI_API_KEY="sk-..."
# OPENROUTER_API_KEY="sk-or-..."
